# Supabase Configuration
# Get these from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe Configuration
# Get these from your Stripe dashboard
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# Stripe Webhook Secret
# Run `stripe listen --forward-to localhost:3000/api/webhook` to get this
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# This is a secret key used to sign JWTs, cookies, etc.
# Generate a strong random string, e.g., `openssl rand -hex 32`
AUTH_SECRET=your-32-byte-long-auth-secret